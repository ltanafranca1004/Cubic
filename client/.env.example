# Copy to client/.env.local (never commit real values). Read at BUILD time by Vite.
# URL of the game server, no trailing slash.
# - Production (Vercel): set it to the Render URL, e.g. https://cubic-server.onrender.com
# - Local dev: leave it unset. The client then uses its own origin and Vite proxies
#   /socket.io to http://localhost:3001, which also makes a single tunnel URL work.
VITE_SERVER_URL=

# PostHog product analytics (anonymous usage stats). Leave both empty in dev: with no key
# nothing is loaded or sent. Production (Vercel): the project key (phc_...) of the shared
# PostHog project; every Cubic event is tagged app = 'cubic'.
VITE_POSTHOG_KEY=
# Defaults to https://us.i.posthog.com when empty.
VITE_POSTHOG_HOST=
