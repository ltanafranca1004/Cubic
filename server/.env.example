# Copy to server/.env (never commit real values, never put real keys in this file).

# Port the server listens on. Render sets this itself.
PORT=3001
# Allowed browser origins, comma-separated. "*" matches inside a host, e.g.
# https://cubic.vercel.app,https://cubic-*.vercel.app,https://cubic.tech
# localhost origins are always allowed when NODE_ENV is not "production".
CLIENT_ORIGIN=http://localhost:5173
# DEV_COMMANDS=1: obey the dev tools' teleport and solve commands (client ?dev). Ignored when NODE_ENV=production.
DEV_COMMANDS=

# --- AI partner ("Play with AI"). Server-side only, never sent to the client.
# Gemini API key (https://aistudio.google.com/apikey). Empty = no AI unless AI_FAKE=1.
GEMINI_API_KEY=
# Gemini model ID. Empty = gemini-3.5-flash (stable Flash with a free tier).
GEMINI_MODEL=
# AI_FAKE=1: scripted partner instead of Gemini, no key needed (dev and demo fallback).
AI_FAKE=
# Partner personality: default | tsundere. Changes tone only.
AI_PERSONA=default

# --- AI partner voice.
# browser = free speechSynthesis in the player's browser, elevenlabs = ElevenLabs clips.
# Empty = browser, or elevenlabs when NODE_ENV=production. Falls back to browser if the
# ElevenLabs key is missing or a call fails.
TTS_MODE=
# ElevenLabs API key (needs the Text to Speech permission).
ELEVENLABS_API_KEY=
# ElevenLabs voice ID. Empty = a stock voice.
ELEVENLABS_VOICE_ID=
# ElevenLabs model ID. Empty = eleven_flash_v2_5 (half price per character).
ELEVENLABS_MODEL_ID=

# --- Voice: TURN relay for calls that cannot connect directly. Optional: all three or none.
# TURN server URLs, comma-separated (turn:host:port, turns:host:port?transport=tcp). Empty = STUN only.
TURN_URLS=
# TURN username (static, long-term credential).
TURN_USERNAME=
# TURN password. Sent to allowed clients by GET /ice, so use a relay-only credential.
TURN_CREDENTIAL=
