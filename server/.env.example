# Copy to server/.env (never commit real values).
# Port the server listens on. Render sets this itself.
PORT=3001
# Comma-separated list of allowed browser origins (the Vercel URL in production).
# localhost origins are always allowed when NODE_ENV is not "production".
CLIENT_ORIGIN=http://localhost:5173
# Gemini (Phase 2, "Play with AI"). Server-side only, never sent to the client.
GEMINI_API_KEY=
# Optional. Defaults to gemini-flash-latest.
GEMINI_MODEL=
# Optional, dev/demo only: AI_FAKE=1 uses a scripted partner instead of Gemini (no key needed).
AI_FAKE=
# ElevenLabs (the AI partner's voice). Server-side only.
ELEVENLABS_API_KEY=
# Optional. Defaults to a stock ElevenLabs voice.
ELEVENLABS_VOICE_ID=
