# Copy to server/.env (never commit real values, never put real keys in this file).

# Port the server listens on. Render sets this itself.
PORT=3001
# Allowed browser origins, comma-separated. "*" matches inside a host, e.g.
# https://cubic.vercel.app,https://cubic-*.vercel.app,https://cubic.tech
# localhost origins are always allowed when NODE_ENV is not "production".
CLIENT_ORIGIN=http://localhost:5173
# DEV_COMMANDS=1: obey the dev tools' teleport and solve commands (client ?dev). Ignored when NODE_ENV=production.
DEV_COMMANDS=

# --- Inactivity (lobby and game). A player who does nothing (no key, tap, move, chat or
# talking) for INACTIVE_MS gets a countdown in the chat, and is removed INACTIVE_WARN_MS
# later. Only that player: the other one keeps the room. Milliseconds.
# Empty = 240000 (4 minutes).
INACTIVE_MS=
# Empty = 60000 (60 seconds).
INACTIVE_WARN_MS=

# --- AI partner ("Play with AI"). Server-side only, never sent to the client.
# Gemini API key (https://aistudio.google.com/apikey). Optional: it only advises the scripted
# partner (natural lines, reading free-form chat). Empty = the scripted partner plays alone.
GEMINI_API_KEY=
# Gemini model ID. Empty = gemini-3.5-flash (stable Flash with a free tier).
GEMINI_MODEL=
# AI_FAKE=1: never call Gemini, even with a key (dev, tests, demo fallback).
AI_FAKE=
# Kill switch for Gemini. false = every AI line is scripted, nothing is ever called.
# Empty = on (it still needs GEMINI_API_KEY).
GEMINI_ENABLED=
# Gemini calls allowed per UTC day, over ALL solo rooms (free plan). Empty = 200.
# Fixed in code: 8 calls a minute server-wide, 25 per game, 10 minutes off after a 429.
GEMINI_DAILY_CAP=
# Partner personality: default | tsundere. Changes tone only.
AI_PERSONA=default

# --- AI partner voice.
# browser = free speechSynthesis in the player's browser, elevenlabs = ElevenLabs clips.
# Empty = browser, or elevenlabs when NODE_ENV=production. Falls back to browser if the
# ElevenLabs key is missing or a call fails.
TTS_MODE=
# Kill switch for ElevenLabs. false = banked clips and the browser voice only.
# Empty = on (it still needs ELEVENLABS_API_KEY and TTS_MODE=elevenlabs).
ELEVENLABS_ENABLED=
# Characters ElevenLabs may be sent per UTC day, over ALL solo rooms. Empty = 20000.
# Only Gemini's own lines are ever bought, at most 20 per game; over a cap the browser reads.
ELEVENLABS_DAILY_CHARS=
# ElevenLabs API key (needs the Text to Speech permission).
ELEVENLABS_API_KEY=
# ElevenLabs voice ID: the partner's ONE voice, for every banked clip and every live line.
# Empty = r1KmysJdVYZjJCm4mL3b. A banked clip is found by voice + bank model + exact text,
# so another id here means the committed bank no longer plays (the browser voice reads).
ELEVENLABS_VOICE_ID=
# Model of the live lines (Gemini's own). Empty = eleven_flash_v2_5 (half price per
# character, fast). The older name ELEVENLABS_MODEL_ID is still read.
ELEVENLABS_MODEL=
# Model of the banked clips (npm run tts:bank -w server): bought once, so the best one.
# Empty = eleven_v4. The server needs the same value to find the clips.
ELEVENLABS_BANK_MODEL=

# --- Voice: TURN relay for calls that cannot connect directly. Optional: all three or none.
# TURN server URLs, comma-separated (turn:host:port, turns:host:port?transport=tcp). Empty = STUN only.
TURN_URLS=
# TURN username (static, long-term credential).
TURN_USERNAME=
# TURN password. Sent to allowed clients by GET /ice, so use a relay-only credential.
TURN_CREDENTIAL=
